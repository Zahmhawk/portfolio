# =================================================================
# HOSTINGER NODE.JS & MYSQL CONFIGURATION
# Copy this file to .env or paste into Hostinger hPanel -> Node.js -> Environment Variables
# =================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Database Configuration (Hostinger hPanel -> Databases -> Management)
# Import database.sql via phpMyAdmin before launching
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_hostinger_db_name
DB_USER=your_hostinger_db_username
DB_PASSWORD=your_hostinger_db_password

# Authentication & Encryption Key (32-byte secret)
CHAT_ENCRYPTION_KEY=12345678901234567890123456789012
OWNER_BOOTSTRAP_ENABLED=true
LOCAL_AUTH_ENABLED=true

# Optional Integrations (Leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
RESEND_API_KEY=
AUTH_FROM_EMAIL=
FILE_STORAGE_DIR=
TRUSTED_PROXY_IPS=